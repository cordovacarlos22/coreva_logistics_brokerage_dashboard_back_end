PORT=4000

# From Supabase Project Settings -> API
# Use the SECRET key here (sb_secret_... / legacy service_role JWT), not the
# publishable/anon key -- this client bypasses RLS for backend operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IAM user/role credentials for Amazon Textract OCR (BOL photos). The IAM
# policy only needs textract:AnalyzeDocument.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Origin allowed to call this API in dev (the Vite dashboard)
ALLOWED_ORIGIN=http://localhost:5173

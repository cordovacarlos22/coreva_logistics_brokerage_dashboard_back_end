PORT=4000

# From Supabase Project Settings -> API
# Use the SECRET key here (sb_secret_... / legacy service_role JWT), not the
# publishable/anon key -- this client bypasses RLS for backend operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Path to the Google Cloud service account JSON key used for Vision API OCR
GOOGLE_APPLICATION_CREDENTIALS=

# Origin allowed to call this API in dev (the Vite dashboard)
ALLOWED_ORIGIN=http://localhost:5173

PORT=4000

# From Supabase Project Settings -> API
# Use the SECRET key here (sb_secret_... / legacy service_role JWT), not the
# publishable/anon key -- this client bypasses RLS for backend operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Full contents of a Google Cloud service-account JSON key (Vision API OCR),
# pasted as a single-line string -- not a file path. Render's web services
# have no persistent disk, so GOOGLE_APPLICATION_CREDENTIALS=/path/to.json
# has nowhere to point.
GOOGLE_CLOUD_CREDENTIALS_JSON=

# Origin allowed to call this API in dev (the Vite dashboard)
ALLOWED_ORIGIN=http://localhost:5173
